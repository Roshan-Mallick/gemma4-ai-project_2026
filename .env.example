# =============================================================================
# SafeHire AI — Environment Variables
# Copy this file to .env and fill in your keys
# =============================================================================

# LLM Configuration (required for scam detection)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemma-4-31b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Abstract API — optional, enables enhanced checks
# Sign up free at https://www.abstractapi.com/
ABSTRACT_EMAIL_API_KEY=your-abstract-email-api-key
ABSTRACT_EMAIL_API_URL=https://emailvalidation.abstractapi.com/v1/
ABSTRACT_PHONE_API_KEY=your-abstract-phone-api-key
ABSTRACT_PHONE_API_URL=https://phoneintelligence.abstractapi.com/v1/
ABSTRACT_IP_API_KEY=your-abstract-ip-api-key
ABSTRACT_IP_API_URL=https://ipgeolocation.abstractapi.com/v1/

# DNS-over-HTTPS providers (optional, rarely need to change)
DNS_OVER_HTTPS_PRIMARY=https://dns.google/resolve
DNS_OVER_HTTPS_FALLBACK=https://cloudflare-dns.com/dns-query

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=*
DEBUG=true
